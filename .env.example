# DATABASE_URL: Local Postgres (docker-compose) connection string.
DATABASE_URL="postgresql://forgex:forgex@localhost:5432/forgex?schema=public"

# AUTH_SECRET: Signs/encrypts NextAuth session JWTs (local dev only — regenerate for any shared env).
AUTH_SECRET="zwPRRYIxPdHMaiGachYj1fWdKX3YzZsE4M8E0w/9hps="

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# GEMINI_MODELS: Comma-separated model names, tried in order. The first is primary; later ones
# are only used as fallback if an earlier one actually errors (rate limit, outage, retired model).
# Defaults to "gemini-3.8-flash" alone if unset — see lib/server/gemini.ts.
GEMINI_MODELS="gemini-3.8-flash,gemini-flash-latest,gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"